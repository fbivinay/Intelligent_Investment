# Local caches. Raw downloads are ignored; processed slices and data/manifest.json are committed.
/data/raw/
/artifacts/
/out/

# Secrets. Nothing here should ever exist, but make it impossible by accident.
.env
.env.*
*.key
access_token

__pycache__/
*.pyc
.venv/
node_modules/
.next/
.playwright-mcp/

# Next.js
web/.next/
web/node_modules/
web/.env*.local
web/next-env.d.ts
.playwright-cli/

# A running download holds this while it lists days
/data/*.lock

# The calculator function bundle, made by tools/bundle_site.py before a deploy
/site/api/_lib/
/site/.next/
/site/node_modules/
/site/.vercel/
/site/test-results/
/site/playwright-report/
/site/tsconfig.tsbuildinfo
/site/next-env.d.ts
